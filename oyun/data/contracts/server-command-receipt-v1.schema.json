{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axyondev.com/contracts/server-command-receipt-v1.schema.json",
  "title": "AXYON Authoritative Command Receipt v1",
  "type": "object",
  "required": ["schemaVersion","actorId","commandId","sourceId","sequence","type","fingerprint","status","code","serverRevision","serverTime","processedAt"],
  "properties": {
    "schemaVersion": {"const": 1},
    "actorId": {"type":"string","minLength":1,"maxLength":128},
    "commandId": {"type":"string","minLength":3,"maxLength":192},
    "sourceId": {"type":"string","minLength":3,"maxLength":96},
    "sequence": {"type":"integer","minimum":1},
    "type": {"type":"string","minLength":3,"maxLength":96},
    "fingerprint": {"type":"string","minLength":8,"maxLength":128},
    "status": {"enum":["accepted","rejected"]},
    "code": {"type":"string","minLength":1,"maxLength":96},
    "data": {},
    "serverRevision": {"type":"integer","minimum":0},
    "serverTime": {"type":"integer","minimum":0},
    "processedAt": {"type":"integer","minimum":0}
  },
  "additionalProperties": false
}
