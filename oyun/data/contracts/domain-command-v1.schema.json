{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axyondev.com/contracts/domain-command-v1.schema.json",
  "title": "AXYON Domain Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "sourceId", "sequence", "actorId", "type", "payload", "issuedAt", "expectedRevision"],
  "properties": {
    "schemaVersion": {"const": 1},
    "commandId": {"type": "string", "minLength": 3, "maxLength": 192, "pattern": "^[A-Za-z0-9._:@-]+$"},
    "sourceId": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[A-Za-z0-9._:@-]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "actorId": {"type": "string", "minLength": 1, "maxLength": 128},
    "type": {"type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[a-z][a-z0-9.-]+$"},
    "payload": {"type": "object"},
    "issuedAt": {"type": "integer", "minimum": 0},
    "expectedRevision": {"type": ["integer", "null"], "minimum": 0},
    "clientSessionId": {"type": "string", "maxLength": 96}
  }
}
